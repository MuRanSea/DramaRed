<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:DramaRed.UI.Models"
        x:Class="DramaRed.UI.Views.MainWindow"
        Width="1280" Height="840"
        MinWidth="1040" MinHeight="680"
        Title="DramaRed"
        KeyDown="OnWindowKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#FF111113" Padding="14,8">
      <TextBlock Name="StatusBar" Classes="muted" Text="就绪" TextWrapping="NoWrap"/>
    </Border>

    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Background="#FF111113" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5" Background="#FFFF4D3A"/>
          <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Text="DramaRed"/>
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="桌面端"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <TextBox Name="SearchBox" Width="360" PlaceholderText="搜索短剧、演员…"
                   KeyDown="OnSearchKeyDown"/>
          <Button Content="搜索" Click="OnSearch"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="隐藏继续听" Click="OnHideToTray" ToolTip.Tip="Ctrl+H · 窗口隐藏，音频继续"/>
          <Button Content="关于" Click="OnAbout"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="212,*">
      <!-- Left nav -->
      <Border Background="#FF111113" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="16,8" FontSize="11"
                     Text="空格播放 · ↑↓切集 · ←→快进"/>
          <ListBox Name="NavList" Classes="nav" SelectionChanged="OnNavChanged" SelectedIndex="0">
            <ListBoxItem Tag="home" Content="首页推荐"/>
            <ListBoxItem Tag="theater" Content="剧场"/>
            <ListBoxItem Tag="search" Content="搜索"/>
            <ListBoxItem Tag="player" Content="正在播放" Name="NavPlayerItem"/>
            <ListBoxItem Tag="history" Content="历史"/>
            <ListBoxItem Tag="favorites" Content="收藏"/>
            <ListBoxItem Tag="settings" Content="设置"/>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Pages -->
      <Panel Grid.Column="1" Margin="20,16">
        <!-- Home -->
        <DockPanel Name="PageHome">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="pageTitle" Text="为你推荐"/>
            <TextBlock Name="HomeHint" Classes="muted" Text="宽屏海报墙，点进播放。不是手机竖滑信息流。"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="HomeGrid" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:PosterItem">
                  <Button Classes="poster" Width="156" Margin="0,0,14,16" Click="OnPosterClick">
                    <StackPanel>
                      <Border Height="220" Background="#22FFFFFF" CornerRadius="10,10,0,0" ClipToBounds="True">
                        <Panel>
                          <TextBlock Text="DramaRed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0.25"/>
                          <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        </Panel>
                      </Border>
                      <StackPanel Margin="8,8,8,10" Spacing="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxHeight="40"/>
                        <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Theater -->
        <DockPanel Name="PageTheater" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="pageTitle" Text="剧场"/>
            <TextBlock Name="TheaterHint" Classes="muted" Text="浏览全部推荐剧目，海报网格找剧。"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="TheaterGrid">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:PosterItem">
                  <Button Classes="poster" Width="156" Margin="0,0,14,16" Click="OnPosterClick">
                    <StackPanel>
                      <Border Height="220" Background="#22FFFFFF" CornerRadius="10,10,0,0" ClipToBounds="True">
                        <Panel>
                          <TextBlock Text="DramaRed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0.25"/>
                          <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        </Panel>
                      </Border>
                      <StackPanel Margin="8,8,8,10" Spacing="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxHeight="40"/>
                        <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Search -->
        <DockPanel Name="PageSearch" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Classes="pageTitle" Text="搜索"/>
            <TextBlock Name="SearchHint" Classes="muted" Text="在顶栏输入关键词，或在此重新搜索。"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="SearchGrid">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:PosterItem">
                  <Button Classes="poster" Width="156" Margin="0,0,14,16" Click="OnPosterClick">
                    <StackPanel>
                      <Border Height="220" Background="#22FFFFFF" CornerRadius="10,10,0,0" ClipToBounds="True">
                        <Panel>
                          <TextBlock Text="DramaRed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0.25"/>
                          <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                        </Panel>
                      </Border>
                      <StackPanel Margin="8,8,8,10" Spacing="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxHeight="40"/>
                        <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Player -->
        <Grid Name="PagePlayer" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="24">
          <StackPanel Spacing="12" Width="300">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
              <Border Width="270" Height="480" CornerRadius="28" Background="#FF0A0A0C"
                      BorderBrush="#33FFFFFF" BorderThickness="2" ClipToBounds="True">
                <Panel>
                  <TextBlock Text="9:16" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Opacity="0.2" FontSize="28"/>
                  <Image Name="PlayerCover" Stretch="UniformToFill"/>
                  <Border Background="#99000000" VerticalAlignment="Bottom" Padding="14,12">
                    <StackPanel Spacing="4">
                      <TextBlock Name="PlayerTitle" FontWeight="SemiBold" TextWrapping="Wrap" Text="未播放"/>
                      <TextBlock Name="PlayerStatus" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 Text="点剧集开始播放。竖屏内容在此预览，影像由 libmpv 窗口输出。"/>
                    </StackPanel>
                  </Border>
                </Panel>
              </Border>
            </Viewbox>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Content="上一集" Click="OnPrevEpisode"/>
              <Button Content="播放/暂停" Click="OnTogglePause"/>
              <Button Content="下一集" Click="OnNextEpisode"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Content="停止" Click="OnStop"/>
              <Button Content="静音" Click="OnMute"/>
            </StackPanel>
            <TextBlock Name="PlayerBackend" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="播放后端：…"/>
          </StackPanel>

          <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Spacing="10">
              <TextBlock Name="SeriesTitle" Classes="pageTitle" Text="选集"/>
              <TextBlock Name="EpisodeHint" Classes="muted" Text="从左侧或剧场打开一部短剧"/>
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
                  <TextBlock VerticalAlignment="Center" Text="清晰度"/>
                  <ComboBox Name="QualityBox" Width="120" SelectionChanged="OnQualityChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
                  <TextBlock VerticalAlignment="Center" Text="倍速"/>
                  <ComboBox Name="RateBox" Width="90" SelectionChanged="OnRateChanged">
                    <ComboBoxItem Tag="0.75" Content="0.75x"/>
                    <ComboBoxItem Tag="1.0" Content="1.0x"/>
                    <ComboBoxItem Tag="1.25" Content="1.25x"/>
                    <ComboBoxItem Tag="1.5" Content="1.5x"/>
                    <ComboBoxItem Tag="2.0" Content="2.0x"/>
                  </ComboBox>
                </StackPanel>
                <CheckBox Name="AutoNextBox" IsChecked="True" Content="自动连播" Margin="0,0,16,8"
                          VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
                  <TextBlock VerticalAlignment="Center" Text="定时停"/>
                  <ComboBox Name="StopAfterBox" Width="120" SelectionChanged="OnStopAfterChanged">
                    <ComboBoxItem Tag="0" Content="关闭"/>
                    <ComboBoxItem Tag="15" Content="15 分钟"/>
                    <ComboBoxItem Tag="30" Content="30 分钟"/>
                    <ComboBoxItem Tag="45" Content="45 分钟"/>
                    <ComboBoxItem Tag="60" Content="60 分钟"/>
                  </ComboBox>
                </StackPanel>
                <Button Name="FavToggleBtn" Content="收藏" Click="OnFavoriteToggle" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Name="TimerHint" Classes="muted" Text="定时停止：关"/>
            </StackPanel>
            <ScrollViewer>
              <ItemsControl Name="EpisodeList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:EpisodeItem">
                    <Button Classes="chip" MinWidth="92" Click="OnEpisodeClick" Content="{Binding ListLabel}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>

        <!-- History -->
        <DockPanel Name="PageHistory" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="pageTitle" Text="历史"/>
            <TextBlock Classes="muted" Text="点一项从上次进度续播。"/>
          </StackPanel>
          <ListBox Name="HistoryList" DoubleTapped="OnHistoryActivate" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:HistoryRow">
                <Grid ColumnDefinitions="56,*" Margin="0,6">
                  <Border Width="48" Height="64" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Classes="muted"/>
                    <TextBlock Text="{Binding Updated}" Classes="muted" FontSize="12"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Favorites -->
        <DockPanel Name="PageFavorites" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="pageTitle" Text="收藏"/>
            <TextBlock Name="FavoritesHint" Classes="muted" Text="收藏的短剧会显示在这里。"/>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="FavoritesGrid">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:PosterItem">
                  <Button Classes="poster" Width="156" Margin="0,0,14,16" Click="OnPosterClick">
                    <StackPanel>
                      <Border Height="220" Background="#22FFFFFF" CornerRadius="10,10,0,0" ClipToBounds="True">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                      </Border>
                      <StackPanel Margin="8,8,8,10" Spacing="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxHeight="40"/>
                        <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="12"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Settings -->
        <ScrollViewer Name="PageSettings" IsVisible="False">
          <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="设置"/>
            <TextBlock TextWrapping="Wrap" Text="桌面端与手机端功能对齐：搜索、推荐、剧场、分集、在线播放（清晰度/倍速/自动连播）、历史续播、收藏、定时停播、后台听。不做下载。"/>
            <Border Background="#FF1C1C1F" CornerRadius="12" Padding="16" Margin="0,4,0,0">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="本地服务"/>
                <TextBlock Name="SettingsHealth" TextWrapping="Wrap" Text="daemon：检测中…"/>
                <TextBlock Name="SettingsBackend" TextWrapping="Wrap" Text="播放后端：…"/>
                <Button HorizontalAlignment="Left" Content="重新检测 / 拉起 daemon" Click="OnAbout"/>
              </StackPanel>
            </Border>
            <Border Background="#FF1C1C1F" CornerRadius="12" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="播放与后台听"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="「隐藏继续听」会把主窗口隐藏到托盘（或仅隐藏），libmpv 音频继续。定时停到点后暂停。预加载会提前解析下一集播放地址。"/>
                <TextBlock TextWrapping="Wrap"
                           Text="快捷键：空格 播放/暂停 · ↑ / PageUp 上一集 · ↓ / PageDown 下一集 · ← → 快退/快进 5 秒 · M 静音 · Ctrl+F 搜索 · Ctrl+H 隐藏继续听 · Esc 离开播放页"/>
              </StackPanel>
            </Border>
            <Border Background="#FF1C1C1F" CornerRadius="12" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Windows 运行"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="发布包可将 drama-daemon.exe 与 DramaRed.UI.exe 放在同一目录。首次启动会自动拉起 daemon。可选将 libmpv-2.dll 放在 exe 旁以显示独立画面窗口；没有 DLL 时仍可浏览、搜索，播放会提示安装。"/>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="个人学习 / 自用。基于非官方 openhongguo SDK，禁止商业使用。短剧内容版权归原权利人。"/>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
